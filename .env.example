# EDXSO School Influencer Discovery Tool - Environment Configuration
# Copy this file to .env to customize settings

# Operating Mode: TEST_DATASET, IMPORTED_DATA, AUTHORIZED_CONNECTOR
DEFAULT_OPERATING_MODE=TEST_DATASET

# Database Path
DATABASE_PATH=data/search_history.db

# Ranking Default Weights (Must sum to 1.0 or 100)
WEIGHT_SEMANTIC_SIMILARITY=0.40
WEIGHT_SCHOOL_ECOSYSTEM=0.25
WEIGHT_LEADERSHIP=0.15
WEIGHT_MULTI_SCHOOL=0.15
WEIGHT_SKILLS_EXPERIENCE=0.05

# Embedding Engine (auto, tfidf, sentence_transformers)
EMBEDDING_ENGINE=auto

# Optional Authorized Connector Settings (Future stub)
# LINKEDIN_API_KEY=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
